{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/bin/projektkort.py"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/bin/session-pointer.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/bin/batch-guard.mjs"
          }
        ]
      }
    ]
  }
}
