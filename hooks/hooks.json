{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/bin/projektkort.py"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/bin/session-pointer.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/bin/runtime-status.py --hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/bin/runtime-status.py --hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/bin/runtime-status.py --hook"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/bin/runtime-status.py --hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/bin/batch-guard.mjs"
          }
        ]
      }
    ]
  }
}
